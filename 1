<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Alltag auf Deutsch – Sprechen üben</title>
<style>
  :root{
    --bg:#0f9b8e;
    --ink:#1f2430;
    --sub:#6b7280;
    --card-bg:#ffffff;
    --shadow: 0 2px 10px rgba(0,0,0,0.06);
    --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background: linear-gradient(160deg, #1B87A8 0%, #17A98F 55%, #22B893 100%);
    background-attachment: fixed;
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  header.top{
    padding:22px 18px 10px;
    text-align:center;
  }
  header.top h1{
    margin:0 0 4px;
    font-size:1.4rem;
    font-weight:800;
    color:#ffffff;
    text-shadow:0 1px 4px rgba(0,0,0,0.15);
  }
  header.top p{
    margin:0;
    color:rgba(255,255,255,0.88);
    font-size:.92rem;
  }
  .stats-bar{
    max-width:520px;
    margin:14px auto 6px;
    padding:14px 18px;
    border-radius:16px;
    background:rgba(255,255,255,0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:var(--shadow);
    border:1px solid rgba(255,255,255,0.25);
  }
  .stats-bar .stat{text-align:center;flex:1;}
  .stats-bar .stat b{display:block;font-size:1.15rem;color:#ffffff;}
  .stats-bar .stat span{font-size:.72rem;color:rgba(255,255,255,0.8);}

  #home{
    max-width:560px;
    margin:0 auto;
    padding:6px 16px 60px;
  }
  .grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:14px;
  }
  .tile{
    border-radius:16px;
    background:var(--card-bg);
    box-shadow:var(--shadow);
    padding:14px 14px 12px;
    cursor:pointer;
    border-top:6px solid var(--accent);
    transition:transform .15s ease, box-shadow .15s ease;
    position:relative;
  }
  .tile:active{transform:scale(0.97);}
  .tile:hover{box-shadow:var(--shadow-lg);}
  .tile .emoji{font-size:1.5rem;}
  .tile h3{
    margin:6px 0 4px;
    font-size:.98rem;
    line-height:1.25;
  }
  .tile .teaser{
    font-size:.74rem;
    color:var(--sub);
    line-height:1.3;
    min-height:2.4em;
  }
  .tile .pill{
    display:inline-block;
    margin-top:8px;
    font-size:.68rem;
    font-weight:700;
    color:var(--accent);
    background:color-mix(in srgb, var(--accent) 15%, white);
    padding:3px 9px;
    border-radius:999px;
  }
  .tile .mini-progress{
    height:4px;
    border-radius:2px;
    background:#eee;
    margin-top:8px;
    overflow:hidden;
  }
  .tile .mini-progress i{
    display:block;height:100%;
    background:var(--accent);
    width:0%;
  }

  /* Topic view */
  #topicView{
    display:none;
    max-width:640px;
    margin:0 auto;
    padding:10px 16px 60px;
  }
  .topic-header{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:14px;
  }
  .back-btn{
    border:none;
    background:#f2f2f5;
    width:38px;height:38px;
    border-radius:50%;
    font-size:1.1rem;
    cursor:pointer;
  }
  .topic-header h2{
    margin:0;
    font-size:1.05rem;
    flex:1;
    color:#ffffff;
    text-shadow:0 1px 3px rgba(0,0,0,0.15);
  }
  .counter{
    font-size:.8rem;
    color:rgba(255,255,255,0.85);
    text-align:center;
    margin-bottom:10px;
  }
  .dots{
    display:flex;
    gap:6px;
    justify-content:center;
    margin-bottom:14px;
    flex-wrap:wrap;
  }
  .dots span{
    width:8px;height:8px;border-radius:50%;
    background:#e2e2e6;
  }
  .dots span.done{background:var(--accent);}
  .dots span.active{outline:2px solid var(--accent);outline-offset:2px;}

  .card-stage{
    perspective:1400px;
    height:360px;
  }
  .flipcard{
    position:relative;
    width:100%;height:100%;
    transform-style:preserve-3d;
    transition:transform .5s cubic-bezier(.2,.8,.2,1);
    cursor:pointer;
  }
  .flipcard.flipped{transform:rotateY(180deg);}
  .face{
    position:absolute;inset:0;
    backface-visibility:hidden;
    border-radius:22px;
    background:var(--card-bg);
    border-top:8px solid var(--accent);
    box-shadow:var(--shadow-lg);
    padding:30px 26px;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  .face .tag{
    position:absolute;
    top:16px;right:18px;
    font-size:.72rem;
    font-weight:700;
    color:var(--accent);
    letter-spacing:.04em;
  }
  .face p{
    font-size:1.28rem;
    line-height:1.6;
    margin:0;
  }
  .face.back{transform:rotateY(180deg);}
  .face.back p{font-size:1.2rem;color:#2c2c34;}
  .hint{
    text-align:center;
    color:rgba(255,255,255,0.8);
    font-size:.78rem;
    margin-top:10px;
  }
  .nav-row{
    display:flex;
    gap:10px;
    margin-top:18px;
  }
  .nav-row button{
    flex:1;
    padding:13px 10px;
    border-radius:14px;
    border:none;
    font-size:.95rem;
    font-weight:700;
    cursor:pointer;
  }
  .nav-row .prev{background:#f2f2f5;color:var(--ink);}
  .nav-row .next{background:var(--accent);color:#fff;}
  .nav-row .done-btn{background:#eafff1;color:#0a7a37;}

  @media (max-width:400px){
    .grid{grid-template-columns:1fr 1fr;gap:10px;}
    .card-stage{height:380px;}
    .face p{font-size:1.15rem;}
  }

  /* iPad / tablet and larger */
  @media (min-width:700px){
    #home, #topicView{
      max-width:760px;
    }
    .grid{
      grid-template-columns:repeat(3, 1fr);
      gap:16px;
    }
    .tile{padding:18px 18px 16px;}
    .tile .emoji{font-size:1.8rem;}
    .tile h3{font-size:1.05rem;}
    .tile .teaser{font-size:.8rem;}
    header.top h1{font-size:1.7rem;}
    header.top p{font-size:1.05rem;}
    .stats-bar{max-width:640px;padding:18px 24px;}
    .stats-bar .stat b{font-size:1.4rem;}
    .stats-bar .stat span{font-size:.82rem;}
    .topic-header h2{font-size:1.3rem;}
    .counter{font-size:.9rem;}
    .card-stage{height:440px;}
    .face{padding:44px 46px;border-radius:26px;}
    .face p{font-size:1.55rem;line-height:1.65;}
    .face.back p{font-size:1.45rem;}
    .face .tag{font-size:.85rem;top:22px;right:26px;}
    .hint{font-size:.9rem;}
    .nav-row button{padding:16px 12px;font-size:1.05rem;}
    .dots span{width:10px;height:10px;}
  }
</style>
</head>
<body>

<header class="top">
  <h1>🗣️ Alltag auf Deutsch</h1>
  <p>Kısa günlük hayat metinleriyle akıcı konuşma pratiği</p>
</header>

<div class="stats-bar" id="statsBar">
  <div class="stat"><b id="totalCount">0</b><span>Metin</span></div>
  <div class="stat"><b id="doneCount">0</b><span>Ezberlendi</span></div>
  <div class="stat"><b id="percentCount">0%</b><span>İlerleme</span></div>
</div>

<div id="home">
  <div class="grid" id="grid"></div>
</div>

<div id="topicView">
  <div class="topic-header">
    <button class="back-btn" onclick="goHome()">←</button>
    <h2 id="topicTitle"></h2>
  </div>
  <div class="counter" id="counter"></div>
  <div class="dots" id="dots"></div>

  <div class="card-stage">
    <div class="flipcard" id="flipcard" onclick="flip()">
      <div class="face front">
        <span class="tag">DE</span>
        <p id="frontText"></p>
      </div>
      <div class="face back">
        <span class="tag">TR</span>
        <p id="backText"></p>
      </div>
    </div>
  </div>
  <div class="hint">Kartı çevirmek için dokun</div>

  <div class="nav-row">
    <button class="prev" onclick="prevCard()">‹ Önceki</button>
    <button class="done-btn" onclick="toggleDone()" id="doneBtn">✓ Ezberledim</button>
    <button class="next" onclick="nextCard()">Sonraki ›</button>
  </div>
</div>

