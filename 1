// ---------- State & storage ----------
const STORAGE_KEY = "alltag_de_progress_v1";
let progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
let currentTopic = null;
let currentIndex = 0;
let flipped = false;

function saveProgress(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
}
function cardKey(topicId, idx){ return topicId + "_" + idx; }

function totalCards(){
  return TOPICS.reduce((s,t)=>s+t.texts.length,0);
}
function doneCards(){
  return Object.values(progress).filter(Boolean).length;
}

function renderStats(){
  document.getElementById('totalCount').textContent = totalCards();
  document.getElementById('doneCount').textContent = doneCards();
  const pct = totalCards() ? Math.round(100*doneCards()/totalCards()) : 0;
  document.getElementById('percentCount').textContent = pct + "%";
}

function renderGrid(){
  const grid = document.getElementById('grid');
  grid.innerHTML = "";
  TOPICS.forEach(t=>{
    const doneInTopic = t.texts.filter((_,i)=>progress[cardKey(t.id,i)]).length;
    const pct = Math.round(100*doneInTopic/t.texts.length);
    const tile = document.createElement('div');
    tile.className = "tile";
    tile.style.setProperty('--accent', t.accent);
    tile.onclick = ()=>openTopic(t.id);
    tile.innerHTML = `
      <div class="emoji">${t.emoji}</div>
      <h3>${t.title_tr}<br><small style="color:var(--sub);font-weight:500;">${t.title_de}</small></h3>
      <div class="teaser">${t.teaser}</div>
      <span class="pill">${t.texts.length} metin</span>
      <div class="mini-progress"><i style="width:${pct}%"></i></div>
    `;
    grid.appendChild(tile);
  });
  renderStats();
}

function openTopic(id){
  currentTopic = TOPICS.find(t=>t.id===id);
  currentIndex = 0;
  flipped = false;
  document.getElementById('home').style.display = "none";
  document.getElementById('statsBar').style.display = "none";
  document.getElementById('topicView').style.display = "block";
  document.getElementById('topicTitle').textContent = currentTopic.title_tr + " · " + currentTopic.title_de;
  document.documentElement.style.setProperty('--accent', currentTopic.accent);
  renderCard();
}

function goHome(){
  document.getElementById('topicView').style.display = "none";
  document.getElementById('home').style.display = "block";
  document.getElementById('statsBar').style.display = "flex";
  renderGrid();
}

function renderCard(){
  const t = currentTopic;
  const item = t.texts[currentIndex];
  document.getElementById('frontText').textContent = item.de;
  document.getElementById('backText').textContent = item.tr;
  document.getElementById('counter').textContent = (currentIndex+1) + " / " + t.texts.length;
  flipped = false;
  document.getElementById('flipcard').classList.remove('flipped');
  document.getElementById('flipcard').style.setProperty('--accent', t.accent);

  const stage = document.querySelectorAll('.face');
  stage.forEach(f=>f.style.borderTopColor = t.accent);

  // dots
  const dotsEl = document.getElementById('dots');
  dotsEl.innerHTML = "";
  t.texts.forEach((_,i)=>{
    const d = document.createElement('span');
    if(progress[cardKey(t.id,i)]) d.classList.add('done');
    if(i===currentIndex) d.classList.add('active');
    d.style.background = (i===currentIndex) ? t.accent : (progress[cardKey(t.id,i)] ? t.accent : "#e2e2e6");
    dotsEl.appendChild(d);
  });

  const doneBtn = document.getElementById('doneBtn');
  const isDone = progress[cardKey(t.id,currentIndex)];
  doneBtn.textContent = isDone ? "✓ Ezberlendi" : "✓ Ezberledim";
  doneBtn.style.opacity = isDone ? "1" : "0.85";
}

function flip(){
  flipped = !flipped;
  document.getElementById('flipcard').classList.toggle('flipped', flipped);
}

function nextCard(){
  if(currentIndex < currentTopic.texts.length-1){
    currentIndex++;
  } else {
    currentIndex = 0;
  }
  renderCard();
}
function prevCard(){
  if(currentIndex > 0){
    currentIndex--;
  } else {
    currentIndex = currentTopic.texts.length-1;
  }
  renderCard();
}
function toggleDone(){
  const key = cardKey(currentTopic.id, currentIndex);
  progress[key] = !progress[key];
  saveProgress();
  renderCard();
}

// keyboard nav
document.addEventListener('keydown', (e)=>{
  if(document.getElementById('topicView').style.display !== "block") return;
  if(e.key === "ArrowRight") nextCard();
  else if(e.key === "ArrowLeft") prevCard();
  else if(e.key === " "){ e.preventDefault(); flip(); }
});

// swipe nav
let touchStartX = null;
document.getElementById('flipcard') && document.addEventListener('touchstart', e=>{
  touchStartX = e.touches[0].clientX;
});
document.addEventListener('touchend', e=>{
  if(touchStartX===null) return;
  const dx = e.changedTouches[0].clientX - touchStartX;
  if(Math.abs(dx) > 50 && document.getElementById('topicView').style.display === "block"){
    if(dx < 0) nextCard(); else prevCard();
  }
  touchStartX = null;
});

renderGrid();
</script>
</body>
</html>
